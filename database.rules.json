{
  "rules": {
    ".read": true,
    ".write": true,
    "nodes": {
      "$node_id": {
        "telemetry": {
          ".read": true,
          ".write": true
        },
        "hardware_alert": {
          ".read": true,
          ".write": true
        },
        "alert_history": {
          ".read": true,
          ".write": true
        }
      }
    },
    "incidents": {
      ".read": true,
      ".write": true,
      "$incident_id": {
        ".read": true,
        ".write": true,
        "dispatch": {
          ".read": true,
          ".write": true
        }
      }
    },
    "satellite": {
      ".read": true,
      ".write": true
    },
    "diagnostics": {
      ".read": true,
      ".write": true
    }
  }
}

